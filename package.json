{
  "name": "fracture-field",
  "private": true,
  "version": "0.1.0",
  "description": "FRACTURE FIELD \u2014 two-player, server-authoritative elemental physics arena game",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @ff/web dev",
    "dev:worker": "pnpm --filter @ff/room-worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:worker": "pnpm --filter @ff/room-worker test:live",
    "benchmark:sim": "tsx packages/sim/bench/bench-sim.ts",
    "benchmark:elements": "tsx packages/sim/bench/bench-elements.ts",
    "benchmark:gestures": "tsx packages/gestures/bench/detection.ts",
    "benchmark:worker": "pnpm --filter @ff/room-worker bench:live",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
