# Copy to apps/web/.env.local for local development. Never commit real values.
# Base URL of the authoritative room service (Cloudflare Worker). wss:// in production.
VITE_ROOM_SERVICE_URL=http://127.0.0.1:8787

# Room worker secrets live in apps/room-worker/.dev.vars locally (see apps/room-worker/.dev.vars.example)
# and in `wrangler secret put` for deployed environments.
